# Server
PORT=3000

# Which client config to run this server as (see src/clients/*.json)
CLIENT_SLUG=usama-ortho

# Claude API — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta) — from your BSP or Meta Business dashboard.
# Leave blank to run in mock mode: replies are printed to the console
# instead of actually sent, so you can build/test before going live.
WHATSAPP_VERIFY_TOKEN=boneline-verify-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
