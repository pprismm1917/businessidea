# Cloudflare headers file (copied to dist/_headers by build.mjs; the two {{...}} lines are filled in automatically).
# If you add another outside service later (chat widget, analytics, video embed...), add its domain
# to the Content-Security-Policy line below, or the browser will block it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-LfFH5bGWuo6hLFy2yzPc1M6j8ONc6CcC/p9NZH4ibiY=' https://assets.calendly.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; img-src 'self' data: https://assets.calendly.com; font-src 'self'; frame-src https://calendly.com https://*.calendly.com; connect-src 'self' https://formspree.io https://cloudflareinsights.com https://calendly.com; form-action 'self' https://formspree.io mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# CSS, JS, fonts and images: cache for a year (build.mjs adds ?v=... to links whenever a file changes)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pages: always check for a fresh copy
