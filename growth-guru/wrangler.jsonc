// Cloudflare Workers config for the Growth Guru Agency website.
// It uploads the finished site in ./dist (made by `node build.mjs`).
// "name" must match the Worker name in the Cloudflare dashboard.
{
  "name": "growth-guru",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
